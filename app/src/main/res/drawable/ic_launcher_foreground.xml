            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Play/Flux Core Emblem -->
    <path android:pathData="M56,38 L76,54 L56,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="56" android:startY="38"
                android:endX="76" android:endY="70"
                android:type="linear">
                <item android:color="#FFA23A" android:offset="0.0" />
                <item android:color="#FF2A6D" android:offset="0.5" />
                <item android:color="#9D4EDD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M78,44 L78,64"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="78" android:startY="44"
                android:endX="78" android:endY="64"
                android:type="linear">
                <item android:color="#FF2A6D" android:offset="0.0" />
