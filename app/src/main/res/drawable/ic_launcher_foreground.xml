    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sound waves / equalizer bars for Flux audio -->
    <path android:pathData="M30,48 L30,60"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30" android:startY="48"
                android:endX="30" android:endY="60"
                android:type="linear">
                <item android:color="#FF6B4A" android:offset="0.0" />
                <item android:color="#FF3366" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M38,40 L38,68"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="38" android:startY="40"
                android:endX="38" android:endY="68"
                android:type="linear">
                <item android:color="#FF8A3D" android:offset="0.0" />
                <item android:color="#FF4071" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M46,34 L46,74"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="46" android:startY="34"
